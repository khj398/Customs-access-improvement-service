# Additional_Experiment/config/.env  (이 파일을 .env 로 복사해 사용)
# ---------------------------------------------------------------
# 실제 비밀번호/키가 들어가는 .env 파일은 절대 커밋하지 않는다.
# (실험계획서 5.4 경고 3: 자격 정보는 논문·부록·스크린샷 어디에도 노출 금지)

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=customs_auction

# cais_back REST API
API_BASE=http://localhost:3000

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# OpenAI (E7 · E13 에서만 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 실험 실행 식별자 (결과 폴더 접미사, 미지정 시 자동 생성)
# EXP_RUN_ID=20260828
